# حالت آفلاین (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# حالت آنلاین — هر API سازگار با OpenAI (OpenRouter، Numes، Baseten، LM Studio، vLLM و…)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
ONLINE_MODEL=gpt-4o-mini

# نمونهٔ Numes.ai: کلید را فقط اینجا (فایل .env که در .gitignore است) بگذارید.
# هرگز کلید را در کد، فایل‌های docs/ یا سایت عمومی قرار ندهید.
# OPENAI_BASE_URL=https://api.numes.ai/api/v1
# OPENAI_API_KEY=
# ONLINE_MODEL=openai/gpt-6-luna

# یا Google Gemini
GEMINI_API_KEY=

# پورت سرور
PORT=3000
